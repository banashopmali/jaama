datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  owner
  admin
  employe
  comptable
  vendeur
}

enum StockMovementType {
  OPENING
  SALE_OUT
  PURCHASE_IN
  ADJUSTMENT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER
  RETURN
  RETURN_IN
  RETURN_OUT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  TO_COLLECT
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  cash
  wave
  orange_money
  bank_transfer
  card
}

enum PaymentRecordStatus {
  SUCCESS
  FAILED
  REVERSED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum ImportBatchStatus {
  PREVIEWED
  COMPLETED
  EXPIRED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  PARTIALLY_PAID
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentAttemptStatus {
  CREATED
  PENDING_PROVIDER
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum SettlementStatus {
  PENDING
  PARTIALLY_SETTLED
  SETTLED
  RECONCILIATION_REQUIRED
  RECONCILED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum PaymentReconciliationStatus {
  MATCHED
  DISCREPANCY_AMOUNT
  DISCREPANCY_STATUS
  UNMATCHED_PROVIDER
  UNMATCHED_INTERNAL
}

enum PaymentProviderType {
  mock
  wave
  orange_money
  moov_money
  mtn_momo
  bank_transfer
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  status    String   @default("active") // "active" | "disabled"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credential        Credential?
  sessions          Session[]
  memberships       Membership[]
  sales             Sale[]         @relation("SellerSales")
  auditEvents       AuditEvent[]   @relation("ActorAuditEvents")
  createdExpenses   Expense[]      @relation("ExpenseCreator")
  createdReceivings Receiving[]    @relation("ReceivingCreator")
  notifications     Notification[]
  importBatches     ImportBatch[]  @relation("ActorImportBatches")
}

model Credential {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // "active" | "suspended"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  customers          Customer[]
  products           Product[]
  inventoryBalances  InventoryBalance[]
  stockMovements     StockMovement[]
  sales              Sale[]
  payments           Payment[]
  saleLines          SaleLine[]
  quotes             Quote[]
  quoteLines         QuoteLine[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  expenses           Expense[]
  suppliers          Supplier[]
  purchases          Purchase[]
  purchaseLines      PurchaseLine[]
  receivings         Receiving[]
  receivingLines     ReceivingLine[]
  notifications      Notification[]
  auditEvents        AuditEvent[]
  outboxEvents       OutboxEvent[]
  idempotencyRecords IdempotencyRecord[]
  invitations        OrganizationInvitation[]
  importBatches      ImportBatch[]
  paymentProviderConfigs PaymentProviderConfig[]
  paymentIntents         PaymentIntent[]
  paymentAttempts        PaymentAttempt[]
  providerTransactions   ProviderTransaction[]
  settlements            Settlement[]
  reconciliationRecords  ReconciliationRecord[]
  webhookEvents          WebhookEvent[]
}

model OrganizationInvitation {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String
  role            Role         @default(vendeur)
  tokenHash       String       @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String
  createdAt       DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(vendeur)
  status         String       @default("active") // "active" | "disabled"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  status         String       @default("active") // "active" | "archived"
  type           String       @default("walk_in") // "walk_in" | "registered"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sales    Sale[]
  quotes   Quote[]
  invoices Invoice[]
  paymentIntents PaymentIntent[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
}

model Product {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku               String
  name              String
  description       String?
  category          String
  unitPriceMinor    Int
  costMinor         Int?
  currencyCode      String       @default("XOF")
  status            String       @default("active") // "active" | "inactive" | "archived"
  barcode           String?
  lowStockThreshold Int?         @default(5)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  saleLines         SaleLine[]
  quoteLines        QuoteLine[]
  invoiceLines      InvoiceLine[]
  purchaseLines     PurchaseLine[]
  receivingLines    ReceivingLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
}

model InventoryBalance {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId         String
  product           Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  availableQuantity Int          @default(0)
  reservedQuantity  Int          @default(0)
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, productId])
  @@unique([organizationId, id])
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  movementType   StockMovementType
  quantityDelta  Int
  reference      String?
  recordedAt     DateTime          @default(now())

  @@unique([organizationId, id])
  @@index([organizationId, productId, recordedAt])
}

model Sale {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String
  customerId     String?
  customer       Customer?     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: SetNull)
  sellerUserId   String
  seller         User          @relation("SellerSales", fields: [sellerUserId], references: [id], onDelete: Restrict)
  subtotalMinor  Int
  discountMinor  Int           @default(0)
  totalMinor     Int
  paidMinor      Int           @default(0)
  remainingMinor Int
  saleStatus     SaleStatus    @default(COMPLETED)
  paymentStatus  PaymentStatus @default(TO_COLLECT)
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())

  lines    SaleLine[]
  payments Payment[]
  invoices Invoice[]
  paymentIntents PaymentIntent[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, occurredAt])
  @@index([organizationId, customerId])
}

model SaleLine {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId              String
  sale                Sale         @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Cascade)
  productId           String
  product             Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  productNameSnapshot String
  skuSnapshot         String
  quantity            Int
  unitPriceMinor      Int
  lineTotalMinor      Int

  @@unique([organizationId, id])
  @@index([organizationId, saleId])
}

model Payment {
  id                     String              @id @default(uuid())
  organizationId         String
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId                 String
  sale                   Sale                @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Cascade)
  method                 PaymentMethod
  amountMinor            Int
  status                 PaymentRecordStatus @default(SUCCESS)
  sourcePaymentAttemptId String?
  recordedAt             DateTime            @default(now())

  reconciliationRecords ReconciliationRecord[]
  paymentAttempt        PaymentAttempt?

  @@unique([organizationId, id])
  @@unique([organizationId, sourcePaymentAttemptId])
  @@index([organizationId, saleId])
}

model Quote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String
  customerId     String?
  customer       Customer?    @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: SetNull)
  subtotalMinor  Int
  discountMinor  Int          @default(0)
  totalMinor     Int
  expirationDate DateTime?
  status         QuoteStatus  @default(DRAFT)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines QuoteLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, customerId])
}

model QuoteLine {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteId             String
  quote               Quote        @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade)
  productId           String
  product             Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  productNameSnapshot String
  skuSnapshot         String
  quantity            Int
  unitPriceMinor      Int
  lineTotalMinor      Int

  @@unique([organizationId, id])
  @@index([organizationId, quoteId])
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String
  saleId         String?
  sale           Sale?         @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: SetNull)
  customerId     String?
  customer       Customer?     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: SetNull)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  subtotalMinor  Int
  discountMinor  Int           @default(0)
  totalMinor     Int
  paidMinor      Int           @default(0)
  remainingMinor Int
  status         InvoiceStatus @default(ISSUED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines InvoiceLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, customerId])
}

model InvoiceLine {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId           String
  invoice             Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)
  productId           String
  product             Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  productNameSnapshot String
  skuSnapshot         String
  quantity            Int
  unitPriceMinor      Int
  lineTotalMinor      Int

  @@unique([organizationId, id])
  @@index([organizationId, invoiceId])
}

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  status         String       @default("active") // "active" | "archived"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchases Purchase[]
  expenses  Expense[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
}

model Expense {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        String
  description     String
  amountMinor     Int
  currencyCode    String       @default("XOF")
  occurredAt      DateTime     @default(now())
  paymentMethod   String?
  supplierId      String?
  supplier        Supplier?    @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: SetNull)
  reference       String?
  notes           String?
  createdByUserId String
  createdByUser   User         @relation("ExpenseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, id])
  @@index([organizationId, category, occurredAt])
}

model Purchase {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String
  supplierId     String
  supplier       Supplier       @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  totalMinor     Int
  status         PurchaseStatus @default(DRAFT)
  orderDate      DateTime       @default(now())
  expectedDate   DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines      PurchaseLine[]
  receivings Receiving[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, supplierId])
}

model PurchaseLine {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId       String
  purchase         Purchase     @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Cascade)
  productId        String
  product          Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  orderedQuantity  Int
  receivedQuantity Int          @default(0)
  unitCostMinor    Int
  lineTotalMinor   Int

  @@unique([organizationId, id])
  @@index([organizationId, purchaseId])
}

model Receiving {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId     String
  purchase       Purchase     @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Cascade)
  reference      String
  receivedAt     DateTime     @default(now())
  createdById    String
  createdBy      User         @relation("ReceivingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  notes          String?
  createdAt      DateTime     @default(now())

  lines ReceivingLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, purchaseId])
}

model ReceivingLine {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivingId      String
  receiving        Receiving    @relation(fields: [organizationId, receivingId], references: [organizationId, id], onDelete: Cascade)
  productId        String
  product          Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  quantityReceived Int

  @@unique([organizationId, id])
  @@index([organizationId, receivingId])
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String       // "low_stock" | "out_of_stock" | "receivable" | "invoice_due" | "purchase"
  title          String
  message        String
  resourceLink   String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, id])
  @@index([organizationId, userId, isRead, createdAt])
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User         @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: Cascade)
  action         String
  resourceType   String
  resourceId     String
  metadataJson   String       @default("{}")
  requestId      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model OutboxEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      String
  aggregateType  String
  aggregateId    String
  payloadJson    String
  status         OutboxStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
}

model IdempotencyRecord {
  id              String            @id @default(uuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operation       String
  idempotencyKey  String
  requestHash     String
  status          IdempotencyStatus @default(PROCESSING)
  responseJson    String?
  createdAt       DateTime          @default(now())

  @@unique([organizationId, operation, idempotencyKey])
}

model ImportBatch {
  id                    String            @id @default(uuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId               String
  actor                 User              @relation("ActorImportBatches", fields: [actorId], references: [id], onDelete: Cascade)
  entityType            String
  originalFileName      String
  contentHash           String
  normalizedPayloadJson String
  validationErrorsJson  String            @default("[]")
  status                ImportBatchStatus @default(PREVIEWED)
  expiresAt             DateTime
  createdAt             DateTime          @default(now())
  completedAt           DateTime?

  @@unique([organizationId, id])
  @@index([organizationId, entityType])
}

model PaymentProviderConfig {
  id                 String              @id @default(uuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider           PaymentProviderType
  isEnabled          Boolean             @default(true)
  isTestMode         Boolean             @default(true)
  webhookEndpointKey String              @unique @default(uuid())
  apiKeyEncrypted    String?
  apiSecretEncrypted String?
  webhookSecret      String?
  merchantId         String?
  metadataJson       String              @default("{}")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, provider])
  @@index([organizationId, isEnabled])
  @@index([provider, webhookEndpointKey])
}

model PaymentIntent {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String
  amountMinor    Int
  currencyCode   String              @default("XOF")
  status         PaymentIntentStatus @default(REQUIRES_PAYMENT)
  saleId         String?
  sale           Sale?               @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: SetNull)
  customerId     String?
  customer       Customer?           @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: SetNull)
  description    String?
  metadataJson   String              @default("{}")
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  attempts PaymentAttempt[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, saleId])
}

model PaymentAttempt {
  id                String               @id @default(uuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentIntentId   String
  paymentIntent     PaymentIntent        @relation(fields: [organizationId, paymentIntentId], references: [organizationId, id], onDelete: Cascade)
  provider          PaymentProviderType
  amountMinor       Int
  currencyCode      String               @default("XOF")
  status            PaymentAttemptStatus @default(CREATED)
  idempotencyKey    String
  requestHash       String?
  paymentId         String?              @unique
  payment           Payment?             @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: SetNull)
  providerReference String?
  errorCode         String?
  errorMessage      String?
  metadataJson      String               @default("{}")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  transactions ProviderTransaction[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, paymentId])
  @@index([organizationId, paymentIntentId])
  @@index([organizationId, provider, status])
  @@index([providerReference])
}

model ProviderTransaction {
  id                    String              @id @default(uuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentAttemptId      String
  paymentAttempt        PaymentAttempt      @relation(fields: [organizationId, paymentAttemptId], references: [organizationId, id], onDelete: Cascade)
  provider              PaymentProviderType
  providerTransactionId String
  statusRaw             String
  feeMinor              Int                 @default(0)
  netMinor              Int
  rawPayloadJson        String              @default("{}")
  occurredAt            DateTime            @default(now())
  createdAt             DateTime            @default(now())

  reconciliationRecords ReconciliationRecord[]

  @@unique([organizationId, id])
  @@unique([organizationId, provider, providerTransactionId])
  @@index([organizationId, paymentAttemptId])
}

model Settlement {
  id                 String              @id @default(uuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider           PaymentProviderType
  reference          String
  currencyCode       String              @default("XOF")
  totalAmountMinor   Int
  settledAmountMinor Int                 @default(0)
  feeAmountMinor     Int                 @default(0)
  status             SettlementStatus    @default(PENDING)
  settledAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  reconciliationRecords ReconciliationRecord[]

  @@unique([organizationId, id])
  @@unique([organizationId, reference])
  @@index([organizationId, provider, status])
}

model ReconciliationRecord {
  id                    String                      @id @default(uuid())
  organizationId        String
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider              PaymentProviderType
  providerTransactionId String?
  providerTransaction   ProviderTransaction?        @relation(fields: [organizationId, providerTransactionId], references: [organizationId, id], onDelete: SetNull)
  paymentId             String?
  payment               Payment?                    @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: SetNull)
  settlementId          String?
  settlement            Settlement?                 @relation(fields: [organizationId, settlementId], references: [organizationId, id], onDelete: SetNull)
  status                PaymentReconciliationStatus
  discrepancyType       String?
  detailsJson           String                      @default("{}")
  createdAt             DateTime                    @default(now())
  resolvedAt            DateTime?

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, provider])
}

model WebhookEvent {
  id                String              @id @default(uuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider          PaymentProviderType
  eventId           String
  eventType         String
  payloadJson       String
  payloadHash       String
  headersJson       String              @default("{}")
  signatureVerified Boolean             @default(false)
  status            WebhookEventStatus  @default(RECEIVED)
  processedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime            @default(now())

  @@unique([organizationId, provider, eventId])
  @@index([organizationId, status])
  @@index([status, createdAt])
}


